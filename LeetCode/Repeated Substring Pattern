class Solution {
    public boolean repeatedSubstringPattern(String s) {

        int n = s.length();

        for (int i = 1; i <= n / 2; i++) {

            if (n % i == 0) {

                String pattern = s.substring(0, i);

                String repeated = pattern.repeat(n / i);

                if (s.equals(repeated)) {
                    return true;
                }
            }
        }

        return false;
    }
}